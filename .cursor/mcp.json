{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--browser=msedge"]
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp"
    },
    "prompt-optimizer": {
      "command": "npx",
      "args": ["-y", "prompt-ops-mcp"]
    },
    "real-plan": {
      "command": "npx",
      "args": ["-y", "task-guardian-mcp"]
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${env:GITHUB_TOKEN}"
      }
    }
  }
}
